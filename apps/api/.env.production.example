# ============================================
# API Environment Variables - Production
# ============================================

# Server Configuration
PORT=4000
NODE_ENV=production

# MongoDB (use Atlas or managed MongoDB in production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stock-management?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-minimum-32-chars
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Admin User (seeded on first run)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure-admin-password-change-this
ADMIN_NAME=Administrator

# CORS Origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_SHORT=10
RATE_LIMIT_MEDIUM=100
RATE_LIMIT_LONG=1000

# Logging
LOG_LEVEL=info
